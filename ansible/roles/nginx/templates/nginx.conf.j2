upstream app {
# server unix:/home/ec2-user/raisetech-live8-sample-app/tmp/sockets/puma.sock;
  server unix:{{ app_path }}/tmp/sockets/puma.sock;
}

server {
  listen 80 default_server;
  server_name _;

# root /home/ec2-user/raisetech-live8-sample-app/public;
  root {{ app_path }}/public;
  access_log /var/log/nginx/rails_app_access.log;
  error_log  /var/log/nginx/rails_app_error.log;

  #try_files $uri/index.html $uri @app;

  location / {
    proxy_pass http://app;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
  }

  error_page 404             /404.html;
  error_page 500 502 503 504 /500.html;
}

